# ===========================
# EduMind V1 — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ===========================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edumind
POSTGRES_USER=edumind_user
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql+asyncpg://edumind_user:your_postgres_password_here@localhost:5432/edumind

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional: Uncomment below to run Qdrant in serverless disk-storage mode (recommended for non-Docker dev/demo)
# QDRANT_PATH=./data/qdrant_db
QDRANT_COLLECTION_NAME=edumind_resources

# --- Embeddings (OpenAI-compatible) ---
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1
# E.g. text-embedding-3-small (1536 dim) or SiliconFlow BAAI/bge-large-zh-v1.5 (1024 dim)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7

# --- JWT Authentication ---
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
