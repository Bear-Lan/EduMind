# EduMind team-safe local configuration template
# The launcher copies this file to .env on first run.
# Model credentials are intentionally blank and must be configured by an administrator.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Leave blank to use SQLite under ./data/edumind.db
DATABASE_URL=

QDRANT_PATH=./data/qdrant_bge_m3
QDRANT_COLLECTION_NAME=edumind_resources

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=Qwen/Qwen3.5-9B
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_ENABLE_THINKING=false
DEEPSEEK_TIMEOUT_SECONDS=60

# First-run administrator. Change this password immediately after first login.
ADMIN_BOOTSTRAP_USERNAME=edumind_admin
ADMIN_BOOTSTRAP_PASSWORD=EduMindTeam#2026!

# Public development default. Replace before any public or Internet deployment.
JWT_SECRET_KEY=edumind_team_release_2026_replace_before_public_deployment_8Hk2Vp9Q
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
